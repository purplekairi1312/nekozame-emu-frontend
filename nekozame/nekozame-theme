        page.blit(f("Noto Sans CJK JP:regular", 20).render(note, True, (255, 255, 255)), (150, H - 62))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    pg.image.save(page, dest)
    return True


def esde_theme(s, pages=True, again=False, dest=None):
    """nekozame's theme in es-de: its files, your fonts, each system's names and spine,
    and its magazine pages, printed here (again: print them all anew)."""
    if not os.path.isdir(THEME_SRC):
        return False
    dest = dest or os.path.join(ESDE_HOME, "themes/nekozame")
    os.makedirs(dest, exist_ok=True)
    for old in ("core", "collages", "systems"):
        shutil.rmtree(os.path.join(dest, old), ignore_errors=True)
    shutil.copytree(os.path.join(THEME_SRC, "core"), os.path.join(dest, "core"))
    shutil.copyfile(os.path.join(THEME_SRC, "capabilities.xml"), os.path.join(dest, "capabilities.xml"))

    def font(pattern):
        found = subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True).stdout
        if not s.get("pack") or not found:
            return found
        # the pack carries its fonts (noto: sil open font license), so it needs none installed
        os.makedirs(os.path.join(dest, "fonts"), exist_ok=True)
        shutil.copyfile(found, os.path.join(dest, "fonts", os.path.basename(found)))
        return "./fonts/" + os.path.basename(found)
    xml = open(os.path.join(THEME_SRC, "theme.xml")).read()
    for key, pattern in (("JA_BLACK", "Noto Sans CJK JP:black"), ("JA_BOLD", "Noto Sans CJK JP:bold"),
                         ("JA_REGULAR", "Noto Sans CJK JP:regular"), ("SANS_BOLD", "Noto Sans:bold"),
                         ("SANS", "Noto Sans")):
        xml = xml.replace(f"@FONT_{key}@", font(pattern))
    open(os.path.join(dest, "theme.xml"), "w").write(xml)
    from xml.sax.saxutils import escape
    os.makedirs(os.path.join(dest, "systems"), exist_ok=True)
    vertical = {"ー": "丨", "、": "︑", "。": "︒", "・": "・", " ": "　"}
    for system, name in [(k, v[0]) for k, v in SYSTEMS.items()] + [("ports", "Ports")]:
        ja, release = POSTER.get(system, (name, ""))
        year = re.match(r"\d{4}", release)
        if system in FAMILIES:  # its region, beside its name: "メガドライブ｜日本", "Genesis | North America"
            region_en, region_ja = REGIONS[FAMILIES[system][3]]
            ja = re.sub(r"[（(].*?[）)]", "", ja).strip()
            name = re.sub(r"\s*\(.*?\)", "", name).strip()
            ja, name = f"{ja}｜{region_ja}", f"{name} | {region_en}"
        # down the spine: the name, a gap, the page's little line, again and again
        spine = "\n".join(vertical.get(ch, ch) for ch in f"{ja}　●深い青への誘い　" * 3)
        en = f"{name}  ·  {year.group(0) if year else 'nekozame'}  ·  memories of the deep  ·  " * 3
        open(os.path.join(dest, "systems", f"{system}.xml"), "w").write(
            f"<theme>\n    <variables>\n        <nkJa>{escape(ja)}</nkJa>\n        <nkEn>{escape(name)}</nkEn>\n"
            f"        <nkSpine>{escape(spine)}</nkSpine>\n        <nkSpineEn>{escape(en)}</nkSpineEn>\n"
            f"    </variables>\n</theme>\n")
    made = 0
    if pages:
        # every system es-de shows: each folder with something in it (games nekozame
        # can't play itself too, like zipped ones)
        shown = set()
        if s.get("pack"):  # every system there's a page for
            shown = set(SYSTEMS) | {"ports"}
        for root in ([] if s.get("pack") else s["roms"]):
            for d in (os.listdir(root) if os.path.isdir(root) else []):
                path = os.path.join(root, d)
                if not d.startswith(".") and os.path.isdir(path) and any(
                        not f.startswith(".") and not f.lower().endswith((".txt", ".xml"))
                        for f in os.listdir(path)):
                    shown.add(d)
        if os.path.isdir(PORT_LAUNCHERS) and any(f.endswith(".sh") for f in os.listdir(PORT_LAUNCHERS)):
            shown.add("ports")
        for system in sorted(x for x in shown if not s.get("systems") or x in s["systems"]):
            for scheme in SCHEMES:
                for name, bare, lang in ((f"{system}-{scheme}-en", False, "en"), (f"{system}-{scheme}-ja", False, "ja"),
                                         (f"{system}-{scheme}-bare", True, "en")):
                    out = os.path.join(dest, "pages", f"{name}.jpg")
                    if (again or not os.path.exists(out)) and magazine(system, s, scheme, out, bare, lang):
                        made += 1
    say(f"  the nekozame theme is in {dest} ({made} pages printed)")
    return True


MUSIC_EVENTS = {"startup": "start", "game-end": "resume", "game-start": "pause", "suspend": "pause", "quit": "stop",
                "screensaver-start": "pause", "screensaver-end": "resume"}


def esde_music(on=True):
    """es-de's event scripts for the music (nekozame-esde-music): on es-de's start,
    after a game, before one, around the screensaver, on quitting."""
    for event, cmd in MUSIC_EVENTS.items():
        path = os.path.join(ESDE_HOME, "scripts", event, "nekozame-music")
        if on:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write("#!/bin/sh\n# nekozame's music in es-de (nekozame-theme music on)\n"
                        # a screensaver that ends in a game: the game's own event pauses it
                        + ('[ "$1" = game-start ] && exit 0\n' if event == "screensaver-end" else "")
                        + f"exec {shlex.quote(os.path.join(HERE, 'nekozame-music'))} {cmd}\n")
            os.chmod(path, 0o755)
        elif os.path.exists(path):
            os.remove(path)


def esde_folders(esde_home):
    """es-de's own game and media folders, from its settings (its defaults otherwise)."""
    roms, media = os.path.expanduser("~/ROMs"), os.path.join(esde_home, "downloaded_media")
    try:
        xml = open(os.path.join(esde_home, "settings/es_settings.xml"), errors="replace").read()
        m = re.search(r'name="ROMDirectory" value="([^"]+)"', xml)
        roms = os.path.expanduser(m.group(1)) if m and m.group(1) else roms
        m = re.search(r'name="MediaDirectory" value="([^"]+)"', xml)
        media = os.path.expanduser(m.group(1)) if m and m.group(1) else media
    except OSError:
        pass
    return roms, media


def options(argv):
    """--name value... into a dict of lists, and the rest"""
    opts, rest, key = {}, [], None
    for a in argv:
        if a.startswith("--"):
            key = a[2:]
            opts.setdefault(key, [])
        elif key:
            opts[key].append(a)
        else:
            rest.append(a)
    return opts, rest


def main(argv):
    global ESDE_HOME, PORT_LAUNCHERS
    opts, rest = options(argv[1:])
    cmd = rest[0] if rest else ""
    ESDE_HOME = os.path.expanduser((opts.get("es-de") or [ESDE_HOME])[0])
    PORT_LAUNCHERS = os.path.expanduser((opts.get("ports") or [""])[0])
    systems = opts.get("systems") or None
    if cmd == "install":
        roms, media = esde_folders(ESDE_HOME)
        s = {"roms": opts.get("roms") or [roms], "media": opts.get("media") or [media],
             "drawings": (opts.get("drawings") or ["sharks"])[0], "systems": systems}
        return 0 if esde_theme(s, again="again" in opts) else 1
    if cmd == "pack" and len(rest) == 2:
        s = {"pack": True, "roms": [], "media": [], "drawings": (opts.get("drawings") or ["sharks"])[0], "systems": systems}
        return 0 if esde_theme(s, again=True, dest=os.path.join(rest[1], "nekozame")) else 1
    if cmd == "music" and rest[1:2] in (["on"], ["off"]):
        esde_music(on=rest[1] == "on")
        if rest[1] == "off":
            subprocess.run([os.path.join(HERE, "nekozame-music"), "stop"], capture_output=True)
        return 0
    say(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
