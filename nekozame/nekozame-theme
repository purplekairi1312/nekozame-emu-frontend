            fb, fp = f("Noto Sans CJK JP:regular", 26), f("Noto Sans CJK JP:regular", 24)
            lines, plines = lines_of(facts, fb, 800, True), lines_of(poem, fp, 800, True)
        else:
            when = date_en(date)
            intro = (f"The {en_name}, {'in arcades from' if arcade else 'released'} {when}"
                     f"{' by ' + maker_en if maker_en else ''}. " if when else "" if system == "ports" else f"The {en_name}. ")
            facts = intro + plac_en
            poem = ((f"{count} titles rest" if count is not None else "Your games rest") +
                    " here now, quietly, at the bottom of the deep blue. Pick up the controller, and that summer sea opens up once more…")
            fb, fp = f("Noto Sans", 27), f("Noto Sans:italic", 25)
            lines, plines = lines_of(facts, fb, 800, False), lines_of(poem, fp, 800, False)
        for i, ln in enumerate(lines):
            page.blit(fb.render(ln, True, c["body"]), (96, 296 + i * 40))
        py = 296 + len(lines) * 40 + 14
        for i, ln in enumerate(plines):
            page.blit(fp.render(ln, True, c["ink2"] if scheme == "nekozame" else c["body"]), (96, py + i * 36))
        cy = py + len(plines) * 36 + 16
        if lang == "ja":
            page.blit(f("Noto Sans CJK JP:regular", 21).render(caption, True, c["body"]), (96, cy))
        else:  # the ▲ from the japanese font (the italic has none)
            mark = f("Noto Sans CJK JP:regular", 21).render("▲", True, c["body"]); page.blit(mark, (96, cy))
            page.blit(f("Noto Sans:italic", 22).render(caption_en.lstrip("▲ "), True, c["body"]), (96 + mark.get_width() + 6, cy - 1))
        # the data box
        bx, by, bw, bh = 900, 860, 500, 270
        page.fill(c["paper"], (bx, by, bw, bh)); pg.draw.rect(page, c["boxink"], (bx, by, bw, bh), 3)
        pg.draw.rect(page, c["boxink"], (bx + 8, by + 8, bw - 16, 90), 2)
        title = ja if lang == "ja" else en_name
        size = 64
        while f("Noto Sans CJK JP:black", size).size(title)[0] > bw - 60:
            size -= 4
        t = f("Noto Sans CJK JP:black", size).render(title, True, c["boxink"])
        page.blit(t, (bx + 26, by + 53 - t.get_height() // 2))
        if lang == "ja":
            rows = [("機種", KIND[kind][1])]
            rows += [(k, v) for k, v in (("メーカー", maker), ("発売日", date.replace("発売", "").replace("稼働", ""))) if v]
            if count is not None:
                rows.append(("収録", f"{count}本"))
            sep, face = "／", "Noto Sans CJK JP:regular"
        else:
            rows = [("System", KIND[kind][0])]
            rows += [(k, v) for k, v in (("Maker", maker_en), ("Released", date_en(date))) if v]
            if count is not None:
                rows.append(("Titles", f"{count}"))
            sep, face = ": ", "Noto Sans"
        for i, (k, v) in enumerate(rows):
            text = f"{k}{sep}{v}"
            px = 23
            while f(face, px).size(text)[0] > bw - 70:
                px -= 1
            pg.draw.circle(page, c["ink1"], (bx + 32, by + 128 + i * 34), 8)
            page.blit(f(face, px).render(text, True, c["body"]), (bx + 48, by + 112 + i * 34))
        page.blit(f("Noto Sans:bold", 30).render(str(rnd.randint(12, 98)), True, (255, 255, 255)), (90, H - 70))
        note = ("©nekozame　" + ("" if s.get("pack") else "※画面は開発中のものです　") + "写真：NOAA（パブリックドメイン）" if lang == "ja" else
